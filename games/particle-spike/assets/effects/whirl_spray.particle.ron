#![enable(implicit_some)]
// Whirlpool variant C (sprite ring): spray and foam on top of the animated ring. Small bright specks thrown in all directions.
(
    spawn_rate: 0.07,
    spawn_amount: 1,
    emission_shape: Circle(10.0),
    lifetime: (0.6, 0.4),
    linear_speed: (30.0, 0.8),
    direction: ((0.0, 1.0), 1.0),
    scale: (5.0, 0.4),
    scale_curve: (points: [(6.0, 0.0, None), (4.0, 0.6, None), (1.0, 1.0, None)]),
    color_curve: (points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0), 0.0, None),
        ((red: 0.8, green: 0.93, blue: 1.0, alpha: 0.9), 0.5, None),
        ((red: 0.6, green: 0.85, blue: 1.0, alpha: 0.0), 1.0, None),
    ]),
)
