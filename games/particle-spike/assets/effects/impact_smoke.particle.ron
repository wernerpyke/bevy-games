    spawn_rate: 0.001,
    spawn_amount: 12,
    emission_shape: Circle(14.0),
    lifetime: (1.2, 0.3),
    linear_speed: (60.0, 0.6),
    direction: ((1.0, 0.0), 1.0),
    linear_damp: (1.5, 0.0),
    gravity_direction: ((0.0, 1.0), 0.0),
