    scale: (14.0, 0.0),
    scale_curve: (points: [(14.0, 0.0, None), (30.0, 0.5, None), (40.0, 1.0, None)]),
    color_curve: (points: [
        ((red: 0.105, green: 0.021, blue: 0.044, alpha: 0.5), 0.0, None),
        ((red: 0.105, green: 0.021, blue: 0.044, alpha: 0.35), 0.5, None),
        ((red: 0.105, green: 0.021, blue: 0.044, alpha: 0.0), 1.0, None),
    ]),
)
