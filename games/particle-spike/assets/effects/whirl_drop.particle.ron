#![enable(implicit_some)]
// Whirlpool variant A (pivot): a droplet at the emitter, every frame. The droplets stay where they are born, so an emitter
// that moves along a circle leaves an arc of them behind. 0.7 s of life at about 250 px/s of emitter speed is an arc of ~175 px.
(
    spawn_rate: 0.016,
    spawn_amount: 1,
    emission_shape: Circle(3.0),
    lifetime: (0.7, 0.3),
    linear_speed: (0.0, 0.0),
    scale: (7.0, 0.3),
    scale_curve: (points: [(8.0, 0.0, None), (6.0, 0.5, None), (2.0, 1.0, None)]),
    color_curve: (points: [
        ((red: 0.92, green: 0.97, blue: 1.0, alpha: 0.95), 0.0, None),
        ((red: 0.6, green: 0.85, blue: 1.0, alpha: 0.9), 0.3, None),
        ((red: 0.29, green: 0.63, blue: 0.91, alpha: 0.6), 0.7, None),
        ((red: 0.17, green: 0.42, blue: 0.75, alpha: 0.0), 1.0, None),
    ]),
)
