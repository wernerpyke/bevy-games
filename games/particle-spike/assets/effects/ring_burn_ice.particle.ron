#![enable(implicit_some)]
// Ice version: two emitters per position (ring.rs), each at half the rate of ring_burn, so the density is the same.
// Burner: one upward flame or ice shard now and then, around a point on the ring. 40 of these sit on the circle.
// Flames flicker through the 4 frames, shards grow, and each fades out. The lifetime spread de-synchronises neighbours.
(
    spawn_rate: 0.2,
    spawn_amount: 1,
    emission_shape: Circle(14.0),
    lifetime: (0.8, 0.5),
    linear_speed: (10.0, 0.6),
    direction: ((0.0, 1.0), 0.4),
    scale: (30.0, 0.0),
    scale_curve: (points: [(24.0, 0.0, None), (32.0, 0.5, None), (28.0, 1.0, None)]),
    color_curve: (points: [
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 0.0, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 1.0), 0.15, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.85), 0.7, None),
        ((red: 1.0, green: 1.0, blue: 1.0, alpha: 0.0), 1.0, None),
    ]),
)
